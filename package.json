{
  "name": "@uppli-io/level-slider",
  "version": "0.1.1",
  "description": "A few named levels on one small pill, a dot per level: an accessible React slider with no dependency.",
  "keywords": [
    "react",
    "slider",
    "levels",
    "accessible",
    "aria"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uppli-io/level-slider.git"
  },
  "homepage": "https://github.com/uppli-io/level-slider#readme",
  "bugs": "https://github.com/uppli-io/level-slider/issues",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/level-slider.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/level-slider.css dist/",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
